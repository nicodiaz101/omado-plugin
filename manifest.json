{
  "schemaVersion": 1,
  "id": "omado.panel",
  "name": "OmaDo Tasks",
  "version": "1.0.0",
  "author": "omacom-io",
  "license": "GPL-3.0-or-later",
  "description": "OmaDo My Day tasks in the Omarchy top bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaDo Tasks",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center"
  },
  "settings": {
    "position": {
      "type": "enum",
      "values": ["left", "center", "right"],
      "default": "center",
      "label": "Bar position"
    }
  }
}
